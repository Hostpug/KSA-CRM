---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found" bare>
  <main class="nf">
    <div class="code">404</div>
    <h1>Page not found</h1>
    <p class="muted">The page you are looking for does not exist.</p>
    <a class="btn primary" href="/">Go to dashboard</a>
  </main>
</Layout>

<style>
  .nf { min-height: 100dvh; display: grid; place-content: center; text-align: center; gap: 12px; padding: 24px; animation: fade-up .5s var(--ease-out) both; }
  .code { font-size: 84px; font-weight: 800; letter-spacing: -.04em; color: var(--accent); line-height: 1; }
  .nf .btn { justify-self: center; margin-top: 8px; }
</style>
