---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
---
<Layout title="Sign in" bare>
  <div class="auth">
    <section class="auth-art" aria-hidden="true">
      <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
      <div class="art-copy">
        <BrandMark size="big" />
        <h1 data-firm>Karthik S &amp; Associates</h1>
        <p>Chartered Accountants · Practice CRM</p>
        <ul class="art-points">
          <li><Icon name="clients" />Clients, work and billing in one place</li>
          <li><Icon name="calendar" />GST notice due dates and reminders</li>
          <li><Icon name="shield" />Encrypted client portal passwords</li>
        </ul>
      </div>
    </section>

    <section class="auth-form">
      <div class="auth-card">
        <div class="mobile-head">
          <BrandMark />
          <div><b data-firm>Karthik S &amp; Associates</b><span>Practice CRM</span></div>
        </div>
        <h2>Welcome back</h2>
        <p class="muted">Sign in with your office email.</p>

        <form id="login" class="stack" novalidate>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="username" inputmode="email" required autofocus />
          </label>
          <label class="field">
            <span>Password</span>
            <div class="pw">
              <input name="password" type="password" autocomplete="current-password" required />
              <button type="button" class="btn ghost icon" id="togglePw" aria-label="Show password"><Icon name="lock" /></button>
            </div>
          </label>
          <div class="banner" id="loginError" hidden role="alert"><Icon name="alert" /><span></span></div>
          <button class="btn primary block" type="submit" id="loginBtn">Sign in</button>
        </form>
        <p class="small muted foot">Forgot your password? Ask the Owner or Admin to reset it.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .auth { min-height: 100dvh; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .auth { grid-template-columns: 1.1fr 1fr; } }
  .auth-art {
    display: none; position: relative; overflow: hidden; color: #e6f3f0;
    background: radial-gradient(120% 80% at 0% 0%, #17588a 0%, #0b3556 55%, #072640 100%);
  }
  @media (min-width: 960px) { .auth-art { display: flex; align-items: flex-end; padding: 56px; } }
  .blob { position: absolute; border-radius: 50%; filter: blur(50px); opacity: .55; animation: drift 16s ease-in-out infinite; }
  .b1 { width: 420px; height: 420px; background: #1b7f45; top: -120px; right: -80px; }
  .b2 { width: 300px; height: 300px; background: #2e6f8e; bottom: 10%; left: -90px; animation-delay: -5s; }
  .b3 { width: 220px; height: 220px; background: #6fc7a6; top: 40%; right: 20%; opacity: .25; animation-delay: -10s; }
  @keyframes drift { 33% { transform: translate(30px, 40px) scale(1.08); } 66% { transform: translate(-25px, 15px) scale(.95); } }
  .art-copy { position: relative; max-width: 460px; animation: fade-up .7s var(--ease-out) both; }
  .art-copy h1 { font-size: 2.2rem; margin: 22px 0 6px; color: #fff; }
  .art-copy p { color: #a9c7c2; }
  .brand-mark.big { width: 56px; height: 56px; font-size: 20px; border-radius: 16px; }
  .art-points { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; }
  .art-points li { display: flex; align-items: center; gap: 12px; color: #d6e9e5; animation: fade-up .6s var(--ease-out) both; }
  .art-points li:nth-child(1) { animation-delay: .15s; }
  .art-points li:nth-child(2) { animation-delay: .25s; }
  .art-points li:nth-child(3) { animation-delay: .35s; }
  .art-points :global(svg) { width: 20px; height: 20px; color: #6fe0b9; }

  .auth-form { display: grid; place-items: center; padding: calc(24px + env(safe-area-inset-top)) 18px 32px; }
  .auth-card { width: 100%; max-width: 400px; animation: fade-up .55s var(--ease-out) both; }
  .auth-card h2 { font-size: 1.6rem; margin-bottom: 4px; }
  .auth-card form { margin-top: 24px; }
  .mobile-head { display: flex; align-items: center; gap: 12px; margin-bottom: 40px; }
  .mobile-head b { display: block; }
  .mobile-head span:last-child { font-size: 13px; color: var(--muted); }
  @media (min-width: 960px) { .mobile-head { display: none; } }
  .pw { position: relative; }
  .pw input { padding-right: 50px; }
  .pw .btn { position: absolute; right: 2px; top: 1px; color: var(--muted); }
  .foot { margin-top: 22px; text-align: center; }
</style>

<script>
  import { api } from '../lib/api';
  import { clearCachedUser } from '../lib/boot';

  const form = document.getElementById('login') as HTMLFormElement;
  const btn = document.getElementById('loginBtn') as HTMLButtonElement;
  const errBox = document.getElementById('loginError') as HTMLElement;
  const card = document.querySelector('.auth-card') as HTMLElement;
  const pw = form.elements.namedItem('password') as HTMLInputElement;

  document.getElementById('togglePw')?.addEventListener('click', (e) => {
    const show = pw.type === 'password';
    pw.type = show ? 'text' : 'password';
    (e.currentTarget as HTMLElement).setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });

  // Already signed in? Go straight in. Also shows the firm name.
  fetch('/api/auth/me', { credentials: 'same-origin' })
    .then(async (r) => {
      if (r.ok) { location.replace(safeNext()); return; }
      const d = await r.json();
      if (d?.firm?.name) document.querySelectorAll('[data-firm]').forEach((el) => { el.textContent = d.firm.name; });
    })
    .catch(() => {});

  function safeNext() {
    const n = new URLSearchParams(location.search).get('next') || '/';
    // Same-site paths only: blocks "//evil.com" and "/\evil.com" (browsers treat both as another site).
    return /^\/(?![\/\\])[^\s\\]*$/.test(n) && !n.startsWith('/login') ? n : '/';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.hidden = true;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    if (!email || !pw.value) { showError('Enter your email and password.'); return; }
    btn.classList.add('loading');
    try {
      await api('/auth/login', { method: 'POST', body: { email, password: pw.value }, quiet401: true });
      clearCachedUser();
      btn.textContent = 'Signed in';
      location.replace(safeNext());
    } catch (err: any) {
      showError(err.message || 'Could not sign in.');
      pw.select();
    } finally {
      btn.classList.remove('loading');
    }
  });

  function showError(msg: string) {
    (errBox.querySelector('span') as HTMLElement).textContent = msg;
    errBox.hidden = false;
    card.classList.remove('shake');
    void card.offsetWidth;
    card.classList.add('shake');
  }
</script>
