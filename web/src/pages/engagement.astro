---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import EngagementSheets from '../components/EngagementSheets.astro';
import '../styles/detail.css';
---
<Layout title="Engagement" nav="work">
  <a slot="actions" class="btn ghost icon mobile-only" id="backBtn" href="/work" aria-label="Back"><Icon name="back" /></a>

  <div id="loading" class="stack">
    <div class="card card-pad"><div class="skel line"></div><div class="skel line"></div><div class="skel line"></div></div>
    <div class="card card-pad"><div class="skel line"></div><div class="skel line"></div></div>
  </div>

  <div id="view" class="eg" hidden>
    <a class="back desktop-only small" id="backLink" href="/work"><Icon name="back" /><span>Sales orders &amp; work</span></a>

    <!-- Summary -->
    <header class="card eg-hero reveal">
      <div class="eg-top">
        <div class="eg-main">
          <div class="eg-ids" id="gNumbers"></div>
          <h1 id="gName"></h1>
          <p class="svc" id="gService"></p>
        </div>
        <div class="eg-head-actions">
          <span id="gStage"></span>
          <button class="btn" id="edit" type="button"><Icon name="edit" />Edit</button>
        </div>
      </div>
      <div class="eg-facts" id="facts"></div>
    </header>

    <!-- Progress + next step -->
    <section class="card eg-progress reveal" aria-labelledby="nextTitle">
      <div class="stepper" id="stepper"></div>
      <div class="next" id="next">
        <span class="next-ic" id="nextIc"></span>
        <div class="next-txt">
          <div class="next-k">Next step</div>
          <h2 id="nextTitle"></h2>
          <p id="nextText"></p>
        </div>
        <div class="next-actions" id="actions"></div>
      </div>
    </section>

    <div class="eg-grid">
      <div class="eg-col">
        <section class="card reveal" id="estimateCard" hidden>
          <div class="card-head">
            <h2>Estimate <span class="mono small muted" id="estNo"></span></h2>
            <a class="btn ghost" id="printEst" target="_blank" rel="noopener"><Icon name="printer" />Print / PDF</a>
          </div>
          <div class="card-body">
            <form id="estForm" novalidate hidden>
              <div class="lines" id="lines"></div>
              <button class="btn ghost add-line" type="button" id="addLine"><Icon name="plus" />Add line</button>
              <div class="lines-total"><span>Total (before GST)</span><span class="v" id="estTotal">₹0</span></div>
              <label class="field est-notes"><span>Notes / terms on the estimate</span><textarea name="estimate_notes" rows="3" maxlength="4000" placeholder="e.g. GST extra as applicable. 50% advance on confirmation."></textarea></label>
              <div class="row"><span class="spacer"></span><button class="btn primary" type="submit" id="estSave">Save estimate</button></div>
            </form>
            <div id="estView" hidden></div>
          </div>
        </section>

        <section class="card reveal">
          <div class="card-head"><h2>Activity</h2></div>
          <div class="card-body"><ul class="eg-timeline" id="history"></ul></div>
        </section>
      </div>

      <aside class="eg-col">
        <section class="card reveal" id="noticeCard" hidden>
          <div class="card-head"><h2>Linked notice</h2></div>
          <div class="card-body"><ul class="list" id="noticeList"></ul></div>
        </section>
        <section class="card reveal">
          <div class="card-head"><h2>Details</h2></div>
          <div class="card-body"><dl class="eg-details" id="details"></dl></div>
        </section>
      </aside>
    </div>
  </div>

  <EngagementSheets />
</Layout>


<script>
  import { ready } from '../lib/boot';
  import { api } from '../lib/api';
  import { esc, ago, dateOnly, dateTime, icon, initials, toast, toastError, submitting, clearErrors, CLIENT_TYPES } from '../lib/ui';
  import { STAGES, stageBadge, actionsFor, fieldsToAsk, steps, rupees, nextStep, dueIn } from '../lib/stages';
  import { initEngagementSheet } from '../lib/engagementSheets';
  import { noticeBadge, dueInfo } from '../lib/notices';

  const id = new URLSearchParams(location.search).get('id');
  let data: any = null;
  const sheets = initEngagementSheet(() => load());

  const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>';
  const short = (d: string | null | undefined) => (d ? dateOnly(d).replace(/ \d{4}$/, '') : '');
  /** Stagger children (CSP: set via CSSOM, not inline style attributes). */
  const stagger = (el: Element) => Array.from(el.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 12))));

  // ---------- summary ----------
  function renderHero(g: any, total: string) {
    document.getElementById('gNumbers')!.innerHTML = [
      g.so_no ? `<span class="chip mono">${esc(g.so_no)}</span>` : '',
      g.estimate_no ? `<span class="chip mono">${esc(g.estimate_no)}</span>` : '',
      g.category ? `<span class="chip cat">${esc(g.category)}</span>` : '',
      `<span class="chip">${g.kind === 'direct' ? 'Direct task' : 'Lead → sales order'}</span>`,
    ].join('');
    document.getElementById('gName')!.innerHTML = g.client_id ? `<a href="/client?id=${g.client_id}">${esc(g.display_name)}</a>` : esc(g.display_name);
    document.getElementById('gService')!.textContent = g.service;
    document.getElementById('gStage')!.innerHTML = stageBadge(g.stage) + (g.overdue ? ' <span class="badge red dot">Overdue</span>' : '');

    const person = (name: string | null, empty: string) => name
      ? `<span class="avatar">${esc(initials(name))}</span><span>${esc(name)}</span>`
      : `<span class="none">${esc(empty)}</span>`;
    const lead = g.kind === 'sales' && [0, 1, 11].includes(g.stage);
    let facts: { k: string; v: string; s?: string; cls?: string }[];
    if (lead) {
      facts = [
        { k: 'Expected fee', v: g.fee ? esc(rupees(g.fee)) : '<span class="none">Not set</span>' },
        { k: 'Estimate total', v: Number(total) > 0 ? esc(rupees(total)) : '<span class="none">No lines yet</span>', s: g.estimate_date ? `Sent ${esc(dateOnly(g.estimate_date))}` : 'Not sent yet' },
        { k: 'Valid until', v: g.estimate_valid_until ? esc(dateOnly(g.estimate_valid_until)) : '<span class="none">—</span>' },
        { k: 'Created', v: esc(dateOnly(g.created_at)), s: esc(ago(g.created_at)) },
      ];
    } else {
      const d = g.due_date ? dueIn(g.due_date) : '';
      const delivered = g.stage >= 8;
      facts = [
        { k: 'Agreed fee', v: g.fee ? esc(rupees(g.fee)) : '<span class="none">Not set</span>' },
        {
          k: 'Due date', v: g.due_date ? esc(dateOnly(g.due_date)) : '<span class="none">No due date</span>',
          s: delivered ? (g.delivered_on ? `Delivered ${esc(dateOnly(g.delivered_on))}` : '') : esc(d),
          cls: delivered ? '' : g.overdue ? 'bad' : /today|tomorrow|in [23] days/.test(d) ? 'soon' : '',
        },
        { k: 'Assigned to', v: person(g.assigned_name, 'Not assigned') },
        { k: 'Reviewer', v: person(g.reviewer_name, 'Not chosen') },
      ];
    }
    const el = document.getElementById('facts')!;
    el.innerHTML = facts.map((f) => `
      <div class="fact"><span class="k">${esc(f.k)}</span><span class="v">${f.v}</span>${f.s ? `<span class="s ${f.cls || ''}">${f.s}</span>` : ''}</div>`).join('');
    stagger(el);
  }

  // ---------- progress ----------
  function renderStepper(g: any, reached: Record<string, string>) {
    const list = steps(g.kind);
    const pos = (s: number) => list.findIndex((st) => st.key.includes(s));
    const cur = g.stage === 11 ? -1 : pos(g.stage);
    // Business dates where we have them, else when the stage was reached.
    const business: Record<number, string> = { 0: g.created_at, 1: g.estimate_date, 2: g.so_date, 3: g.work_date, 8: g.delivered_on };
    const when = (keys: number[]) => {
      for (const k of keys) if (business[k]) return business[k];
      return keys.map((k) => reached[k]).filter(Boolean).sort().pop() || '';
    };
    const el = document.getElementById('stepper')!;
    el.innerHTML = list.map((st, i) => {
      const cls = cur === -1 ? 'future' : i < cur ? 'done' : i === cur ? `current ${g.stage === 6 ? 'wait' : ''}` : 'future';
      const label = i === cur && g.stage === 6 ? 'Waiting on client' : st.label;
      const dt = cur !== -1 && i <= cur ? short(when(st.key)) : '';
      return `<div class="step ${cls} reveal"><span class="dot">${i < cur ? CHECK : ''}</span>${esc(label)}<span class="dt">${esc(dt)}</span></div>`;
    }).join('');
    stagger(el);
    (el.querySelector('.current') as HTMLElement | null)?.scrollIntoView({ block: 'nearest', inline: 'center' });
  }

  function renderNext(g: any) {
    const n = nextStep(g);
    document.getElementById('next')!.className = `next ${n.tone || ''}`;
    document.getElementById('nextIc')!.innerHTML = icon(n.icon);
    document.getElementById('nextTitle')!.textContent = n.title;
    document.getElementById('nextText')!.textContent = n.text;

    const acts = actionsFor(g.stage, g.next || [], g);
    // Alternatives first, the main action last (right-most on desktop, top on phones via CSS order).
    const rank = (t?: string) => (t === 'danger' ? 0 : t === 'primary' ? 2 : 1);
    const sorted = acts.map((a, i) => ({ a, i })).sort((x, y) => rank(x.a.tone) - rank(y.a.tone));
    const mainIdx = sorted.length ? sorted[sorted.length - 1].i : -1;
    const bar = document.getElementById('actions')!;
    bar.innerHTML = sorted.map(({ a, i }) => {
      const cls = i === mainIdx && a.tone === 'primary' ? 'primary main' : a.tone === 'danger' ? 'ghost danger' : '';
      const asks = fieldsToAsk(a, g).length > 0;
      return `<button class="btn ${cls}" type="button" data-a="${i}">${esc(a.label)}${asks ? '…' : ''}</button>`;
    }).join('');
    bar.querySelectorAll<HTMLButtonElement>('[data-a]').forEach((b) => b.addEventListener('click', async () => {
      if (b.classList.contains('loading')) return;
      b.classList.add('loading');
      try { await sheets.openAction(g, acts[Number(b.dataset.a)], data.total); } finally { b.classList.remove('loading'); }
    }));
  }

  // ---------- details ----------
  function renderDetails(g: any) {
    const rows: [string, string, boolean?][] = [];
    const add = (k: string, v: any, html = false, block = false) => { if (v !== null && v !== undefined && v !== '') rows.push([k, html ? v : esc(v), block]); };
    add('Client', g.client_id ? `<a href="/client?id=${g.client_id}">${esc(g.client_name)}</a>` : `${esc(g.prospect_name || '—')} <span class="badge amber">Prospect</span>`, true);
    const gstin = g.client_id ? g.client_gstin : g.prospect_gstin;
    add('GSTIN', gstin ? `<span class="mono">${esc(gstin)}</span>` : '', true);
    if (!g.client_id) {
      add('PAN', g.prospect_pan ? `<span class="mono">${esc(g.prospect_pan)}</span>` : '', true);
      add('Business type', CLIENT_TYPES[g.prospect_type] || '');
      add('City / state', [g.prospect_city, g.prospect_state].filter(Boolean).join(', '));
    }
    add('Contact', g.contact);
    add('Estimate date', g.estimate_date && dateOnly(g.estimate_date));
    add('Sales order', g.so_date && dateOnly(g.so_date));
    add('Work received', g.work_date && dateOnly(g.work_date));
    add('Delivered on', g.delivered_on && dateOnly(g.delivered_on));
    if (g.stage === 6) add('Information awaited', g.pending_info, false, true);
    if (g.stage === 11) add('Reason closed', g.close_reason);
    add('Internal notes', g.notes, false, true);
    add('Created', `${dateTime(g.created_at)}${g.created_by_name ? `\nby ${g.created_by_name}` : ''}`);
    document.getElementById('details')!.innerHTML = rows.map(([k, v, b]) => `<div class="${b ? 'block' : ''}"><dt>${esc(k)}</dt><dd>${v}</dd></div>`).join('');
  }

  // ---------- estimate ----------
  const lines = document.getElementById('lines')!;
  const estForm = document.getElementById('estForm') as HTMLFormElement;
  const toPaise = (v: string) => (/^\d{1,11}(\.\d{1,2})?$/.test(v.trim()) ? Math.round(Number(v) * 100) : 0);

  function addLine(desc = '', amount = '') {
    const row = document.createElement('div');
    row.className = 'line';
    row.innerHTML = `<input data-d maxlength="250" placeholder="Description of service" value="${esc(desc)}" aria-label="Description" />
      <input data-amt class="amt" inputmode="decimal" placeholder="Amount" value="${esc(amount)}" aria-label="Amount (₹)" />
      <button class="btn ghost icon" type="button" aria-label="Remove line" data-rm>${icon('close')}</button>`;
    lines.appendChild(row);
    return row;
  }
  function recalc() {
    const total = Array.from(lines.querySelectorAll<HTMLInputElement>('[data-amt]')).reduce((s, i) => s + toPaise(i.value), 0);
    document.getElementById('estTotal')!.textContent = rupees(total / 100);
  }
  lines.addEventListener('input', recalc);
  lines.addEventListener('click', (e) => {
    const rm = (e.target as HTMLElement).closest('[data-rm]');
    if (!rm) return;
    rm.closest('.line')!.remove();
    if (!lines.children.length) addLine();
    recalc();
  });
  document.getElementById('addLine')!.addEventListener('click', () => { (addLine().querySelector('[data-d]') as HTMLInputElement).focus(); });

  function renderEstimate(g: any, items: any[], total: string) {
    const card = document.getElementById('estimateCard')!;
    card.hidden = g.kind !== 'sales';
    if (g.kind !== 'sales') return;
    document.getElementById('estNo')!.textContent = g.estimate_no || '';
    const print = document.getElementById('printEst') as HTMLAnchorElement;
    print.href = `/estimate?id=${g.id}`;
    print.hidden = !items.length;
    const editable = [0, 1, 11].includes(g.stage);
    estForm.hidden = !editable;
    const view = document.getElementById('estView')!;
    view.hidden = editable;
    if (editable) {
      lines.innerHTML = '';
      (items.length ? items : [{ description: g.service, amount: g.fee ? String(Number(g.fee)) : '' }]).forEach((it) => addLine(it.description, it.amount ? String(Number(it.amount)) : ''));
      (estForm.elements.namedItem('estimate_notes') as HTMLTextAreaElement).value = g.estimate_notes || '';
      recalc();
    } else {
      view.innerHTML = items.length
        ? `<table class="items"><tbody>${items.map((it) => `<tr><td>${esc(it.description)}</td><td>${esc(rupees(it.amount))}</td></tr>`).join('')}
            <tr class="total"><td>Total (before GST)</td><td>${esc(rupees(total))}</td></tr></tbody></table>
            ${g.estimate_notes ? `<p class="small muted est-notes">${esc(g.estimate_notes)}</p>` : ''}
            <p class="small muted est-notes">Lines are locked after the sales order is confirmed.</p>`
        : '<p class="est-empty">No estimate lines were recorded.</p>';
    }
  }

  estForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(estForm);
    const items = Array.from(lines.querySelectorAll('.line')).map((row) => ({
      description: (row.querySelector('[data-d]') as HTMLInputElement).value,
      amount: (row.querySelector('[data-amt]') as HTMLInputElement).value.replace(/,/g, '').trim(),
    }));
    const body = { revision: data.item.revision, stage: data.item.stage, items, estimate_notes: (estForm.elements.namedItem('estimate_notes') as HTMLTextAreaElement).value };
    const res = await submitting(estForm, document.getElementById('estSave') as HTMLButtonElement, () => api(`/engagements/${id}`, { method: 'PUT', body }));
    if (!res) return;
    toast('Estimate saved');
    load();
  });

  // ---------- activity ----------
  function renderHistory(history: any[]) {
    const byLabel = Object.fromEntries(Object.entries(STAGES).map(([n, l]) => [l, Number(n)]));
    const el = document.getElementById('history')!;
    el.innerHTML = history.length
      ? history.map((h) => {
        const created = h.action === 'engagement.created';
        const move = created || h.action === 'engagement.moved';
        const to = h.detail?.stage ? (typeof h.detail.stage[1] === 'number' ? h.detail.stage[1] : byLabel[h.detail.stage[1]]) : undefined;
        let text = h.summary || h.action;
        if (created) text = `Created as ${h.summary?.startsWith('New task') ? 'a task' : 'a lead'}`;
        else if (move) text = text.replace(/^.*?: /, '');
        else text = 'Details updated';
        return `<li class="${move ? 'move' : ''}">
          <span class="tl-ic">${icon(created ? 'plus' : move ? 'chevron' : 'edit')}</span>
          <div><div class="tl-t">${esc(text)}${created && to !== undefined ? ` ${stageBadge(to)}` : ''}</div>
          <div class="when" title="${esc(dateTime(h.at))}">${esc(h.actor_name || 'System')} · ${esc(ago(h.at))}</div></div>
        </li>`;
      }).join('')
      : '<li class="muted">No activity yet.</li>';
    stagger(el);
  }

  function render(d: any) {
    data = d;
    const g = d.item;
    const lead = [0, 1, 11].includes(g.stage) && g.kind === 'sales';
    const back = lead ? ['/leads', 'Leads & estimates'] : ['/work', 'Sales orders & work'];
    (document.getElementById('backLink') as HTMLAnchorElement).href = back[0];
    (document.querySelector('#backLink span') as HTMLElement).textContent = back[1];
    (document.getElementById('backBtn') as HTMLAnchorElement).href = back[0];
    if (lead) {
      document.querySelectorAll('.nav a, .tabbar a').forEach((a) => a.removeAttribute('aria-current'));
      document.querySelectorAll('a[href="/leads"]').forEach((a) => a.setAttribute('aria-current', 'page'));
    }
    document.title = `${g.display_name} · KSA CRM`;
    (document.querySelector('.topbar .title') as HTMLElement).textContent = g.so_no || g.estimate_no || g.display_name;
    renderHero(g, d.total);
    renderStepper(g, d.reached || {});
    renderNext(g);
    renderDetails(g);
    renderEstimate(g, d.items, d.total);
    renderHistory(d.history);
    renderNotices(d.notices || []);
  }

  function renderNotices(list: any[]) {
    const card = document.getElementById('noticeCard')!;
    card.hidden = !list.length;
    document.getElementById('noticeList')!.innerHTML = list.map((x) => {
      const due = dueInfo(x);
      return `<li><a class="list-item" href="/notice?id=${x.id}">
        <span class="main-col"><span class="t"><span class="form-tag">${esc(x.type_code)}</span>${esc(x.subject)}</span>
          <span class="s">${esc([x.tax === 'gst' ? 'GST' : 'Income tax', x.period, x.purpose === 'appeal' ? 'appeal' : ''].filter(Boolean).join(' · '))}${x.next_due && x.stage !== 8 ? ` · <span class="due ${due.tone}">${esc(due.text)}</span>` : ''}</span></span>
        ${noticeBadge(Number(x.stage))}${icon('chevron', 'chev')}</a></li>`;
    }).join('');
  }

  async function load() {
    if (!id || !/^\d+$/.test(id)) { location.replace('/work'); return; }
    try {
      render(await api(`/engagements/${id}`));
      document.getElementById('loading')!.hidden = true;
      document.getElementById('view')!.hidden = false;
    } catch (err: any) {
      toastError(err);
      if (err.status === 404) setTimeout(() => location.replace('/work'), 1200);
    }
  }

  document.getElementById('edit')!.addEventListener('click', () => sheets.openEdit(data.item));
  ready.then(load);
</script>
