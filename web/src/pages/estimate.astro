---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Estimate" bare>
  <div class="print-bar">
    <a class="btn ghost" id="backTo" href="/leads"><Icon name="back" />Back</a>
    <span class="spacer"></span>
    <button class="btn primary" type="button" id="printBtn"><Icon name="printer" />Print / Save as PDF</button>
  </div>

  <article class="paper" id="paper">
    <div class="skel line"></div><div class="skel line"></div><div class="skel line"></div>
  </article>
</Layout>

<style is:global>
  body[data-bare] { background: var(--surface-2); }
  .print-bar { position: sticky; top: 0; z-index: 5; display: flex; gap: 10px; align-items: center; padding: calc(10px + env(safe-area-inset-top)) 16px 10px; background: color-mix(in srgb, var(--surface-2) 85%, transparent); backdrop-filter: blur(10px); }
  .paper {
    max-width: 820px; margin: 8px auto 40px; background: #fff; color: #17201f; padding: 44px 48px; border-radius: 6px;
    box-shadow: 0 10px 40px rgb(0 0 0 / .12); font-size: 14px; line-height: 1.5; animation: fade-up .5s var(--ease-out) both;
  }
  @media (max-width: 640px) { .paper { padding: 26px 20px; margin: 0 0 24px; border-radius: 0; } }
  .paper .top { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-bottom: 3px solid #0b3556; padding-bottom: 18px; }
  .paper .firm b { display: block; font-size: 20px; color: #0b3556; letter-spacing: -.01em; }
  .paper .firm span { display: block; color: #4f5d5b; white-space: pre-line; }
  .paper .doc { text-align: right; }
  .paper .doc h1 { font-size: 26px; letter-spacing: .08em; color: #1b7f45; margin-bottom: 6px; }
  .paper .doc div { color: #4f5d5b; }
  .paper .doc b { color: #17201f; }
  .paper .to { margin: 22px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 640px) { .paper .to { grid-template-columns: 1fr; } .paper .doc { text-align: left; } }
  .paper .label { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: #6b7a78; font-weight: 700; margin-bottom: 4px; }
  .paper .to span { white-space: pre-line; display: block; }
  .paper table { width: 100%; border-collapse: collapse; margin-top: 6px; }
  .paper th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #4f5d5b; background: #eef3f1; padding: 10px 12px; }
  .paper th:last-child, .paper td:last-child { text-align: right; }
  .paper td { padding: 11px 12px; border-bottom: 1px solid #e1e8e6; vertical-align: top; }
  .paper td.n { width: 36px; color: #6b7a78; }
  .paper tr.total td { border-bottom: 0; font-weight: 800; font-size: 16px; border-top: 2px solid #0b3556; }
  .paper .notes { margin-top: 24px; white-space: pre-line; color: #33403e; }
  .paper .sign { margin-top: 56px; display: flex; justify-content: flex-end; }
  .paper .sign > div { text-align: center; min-width: 220px; color: #4f5d5b; }
  .paper .sign .for { font-weight: 650; color: #17201f; margin-bottom: 56px; }
  .paper .sign .sig { border-top: 1px solid #9aa8a6; padding-top: 8px; }
  .paper .foot { margin-top: 32px; font-size: 12px; color: #6b7a78; text-align: center; }
  @media print {
    @page { size: A4; margin: 14mm; }
    body[data-bare] { background: #fff; }
    .print-bar, .toasts { display: none !important; }
    .paper { box-shadow: none; margin: 0; padding: 0; max-width: none; animation: none; }
  }
</style>

<script>
  import { api } from '../lib/api';
  import { esc, dateOnly, toastError } from '../lib/ui';
  import { rupees } from '../lib/stages';

  const id = new URLSearchParams(location.search).get('id');
  document.getElementById('printBtn')!.addEventListener('click', () => window.print());

  async function load() {
    if (!id || !/^\d+$/.test(id)) { location.replace('/leads'); return; }
    try {
      const d = await api(`/engagements/${id}`);
      const g = d.item;
      const f = d.firm || {};
      (document.getElementById('backTo') as HTMLAnchorElement).href = `/engagement?id=${g.id}`;
      document.title = `${g.estimate_no || 'Estimate'} · ${g.display_name}`;
      const clientAddr = [g.client_address, [g.client_city, g.client_state, g.client_pincode].filter(Boolean).join(', ')].filter(Boolean).join('\n');
      document.getElementById('paper')!.innerHTML = `
        <div class="top">
          <div class="firm"><b>${esc(f.firm_name || '')}</b>
            <span>${esc(f.firm_tagline || '')}</span>
            ${f.firm_address ? `<span>${esc(f.firm_address)}</span>` : ''}
            <span>${esc([f.firm_phone, f.firm_email].filter(Boolean).join(' · '))}</span>
            ${f.firm_gstin ? `<span>GSTIN: ${esc(f.firm_gstin)}</span>` : ''}
          </div>
          <div class="doc"><h1>ESTIMATE</h1>
            <div>No. <b>${esc(g.estimate_no || 'Draft')}</b></div>
            <div>Date <b>${esc(g.estimate_date ? dateOnly(g.estimate_date) : '—')}</b></div>
            ${g.estimate_valid_until ? `<div>Valid until <b>${esc(dateOnly(g.estimate_valid_until))}</b></div>` : ''}
          </div>
        </div>
        <div class="to">
          <div><div class="label">Estimate for</div><b>${esc(g.display_name)}</b>
            ${clientAddr ? `<span>${esc(clientAddr)}</span>` : ''}
            ${g.client_gstin ? `<span>GSTIN: ${esc(g.client_gstin)}</span>` : ''}
            ${g.contact ? `<span>${esc(g.contact)}</span>` : ''}
          </div>
          <div><div class="label">Assignment</div><span>${esc(g.service)}</span></div>
        </div>
        <table>
          <thead><tr><th>#</th><th>Description</th><th>Amount (₹)</th></tr></thead>
          <tbody>
            ${d.items.map((it: any, i: number) => `<tr><td class="n">${i + 1}</td><td>${esc(it.description)}</td><td>${esc(rupees(it.amount))}</td></tr>`).join('')}
            <tr class="total"><td></td><td>Total (before GST)</td><td>${esc(rupees(d.total))}</td></tr>
          </tbody>
        </table>
        ${g.estimate_notes ? `<div class="notes"><div class="label">Notes</div>${esc(g.estimate_notes)}</div>` : ''}
        <div class="sign"><div><div class="for">For ${esc(f.firm_name || '')}</div><div class="sig">Authorised signatory</div></div></div>
        <div class="foot">This is an estimate, not a tax invoice.</div>`;
    } catch (err) { toastError(err); }
  }
  load();
</script>
