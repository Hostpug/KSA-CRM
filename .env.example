# Copy to .env (local) or add these in cPanel > Setup Node.js App > Environment variables.
NODE_ENV=production

# MySQL database created in cPanel > MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ksacrm
DB_USER=ksacrm
DB_PASSWORD=change-me

# Public address of the CRM (used for links in emails and the Origin check)
APP_URL=https://crm.ksaca.net

# Set to 1 when the app runs behind cPanel's proxy (Passenger/Apache). Leave 1 on cPanel.
TRUST_PROXY=1

# Session length in hours
SESSION_HOURS=8

# Password vault encryption key (32 bytes, base64). Generate: npm run vault-key
# BACK IT UP. Without it the saved client passwords cannot be read.
VAULT_KEY=
